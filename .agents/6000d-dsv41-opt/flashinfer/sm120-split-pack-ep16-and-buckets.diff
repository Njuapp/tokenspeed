+def test_packed_xnuma_region_covers_every_bucket() -> None:
+    hidden, _intermediate, topk, experts = DSV41
+    buckets = workspace_compile_buckets(512)
+    region = XnumaLayout(
+        world=16,
+        n_cross=12,
+        experts_per_rank=experts // 16,
+        tokens_per_rank=max(buckets),
+        topk=topk,
+        hidden=hidden,
+        pack=True,
+    )
+    plain = dataclasses.replace(region, pack=False)
+    # The packed staging area is appended; the return rows keep their size.
+    assert region.reserved_bytes > plain.reserved_bytes
+    offsets = region.offsets
+    assert offsets["stage"] - offsets["ret"] == (
+        12 * 2 * 512 * topk * (16 + 2 * hidden)
+    )
+    assert offsets["end"] - offsets["pstage"] == 12 * region.pack_stride
+    for bucket in buckets:
+        layout = dataclasses.replace(region, tokens_per_rank=bucket)
+        assert layout.reserved_bytes <= region.reserved_bytes
+        assert layout.pack_stride <= region.pack_stride
+        # map | weights | scales of the packed rows fit behind the activation
+        # rows of a staged input span of this bucket.
+        assert layout.pack_small_bytes <= bucket * (
+            layout.sf_row_bytes + topk * 8 + topk * 4
+        )
