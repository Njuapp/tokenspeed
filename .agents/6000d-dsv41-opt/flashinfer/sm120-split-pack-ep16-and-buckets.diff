+# EP16 on two hosts of 2 x 4 GPUs: (host, NUMA node) of every EP rank. PCI bus
+# ids and NUMA node numbers repeat on the second host.
+TWO_HOSTS = tuple(
+    (f"host{host}", node) for host in range(2) for node in (0, 0, 0, 0, 1, 1, 1, 1)
+)
+
+
+def _two_host_topology(rank: int):
+    peers = [
+        GpuTopologyEntry(
+            global_rank=index,
+            local_rank=index % 8,
+            pci_bus_id=f"0000:{index % 8 + 1:02x}:00.0",
+            numa_node=node,
+            host=host,
+        )
+        for index, (host, node) in enumerate(TWO_HOSTS)
+    ]
+    return derive_ep_transport_topology(peers, ep_rank=rank)
+
+
+@pytest.mark.parametrize("rank", (0, 3, 4, 8, 15))
+def test_two_host_ep16_topology_and_shadow_segments(rank: int) -> None:
+    topology = _two_host_topology(rank)
+    # Only the GPUs of the same host and NUMA node are P2P peers.
+    assert (topology.same_numa_peer_count, topology.cross_numa_peer_count) == (3, 12)
+    cross = [peer for peer in range(16) if TWO_HOSTS[peer] != TWO_HOSTS[rank]]
+    assert topology.force_ibgda_peer_mask == sum(1 << peer for peer in cross)
+    shadow = ShadowLayout.from_topology(topology, rank)
+    assert shadow.num_segments == 13
+    assert shadow.cross_mask == topology.force_ibgda_peer_mask
+    for peer, segment in shadow.local_segments().items():
+        assert ShadowLayout.from_topology(topology, peer).remote_segments()[rank] == (
+            segment
+        )
+
