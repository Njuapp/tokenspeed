+def _extra_compile_buckets() -> tuple[int, ...]:
+    """More compile buckets from ``MEGAMOE_EXTRA_COMPILE_BUCKETS`` (comma-separated rows per rank).
+
+    A deployment whose decode calls come in fixed row counts (6 rows per stream under DSpark: 6, 12, 24,
+    48, 96, 192) can add them, so that such a call runs kernels compiled, and tuned, for exactly its rows
+    instead of the next larger default bucket. Every bucket costs one more set of compiled kernels and
+    launch graphs. The value must be the same on every EP rank.
+    """
+
+    raw = os.environ.get("MEGAMOE_EXTRA_COMPILE_BUCKETS", "").replace(" ", "")
+    values = tuple(int(v) for v in raw.split(",") if v)
+    if any(v <= 0 for v in values):
+        raise ValueError(f"MEGAMOE_EXTRA_COMPILE_BUCKETS must list positive row counts, got {raw!r}")
+    return values
+
+
+DECODE_GRAPH_COMPILE_BUCKETS = tuple(sorted({*DECODE_GRAPH_COMPILE_BUCKETS, *_extra_compile_buckets()}))
